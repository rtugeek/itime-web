VITE_ITIME_API_BASE_URL=https://itime.fun/api/v2
# WeChat website application AppID (must also be configured on the itime server).
VITE_WECHAT_APP_ID=
# Public URL of this application, without a hash; domain must be registered in WeChat.
VITE_WECHAT_REDIRECT_URI=
# Public OSS settings; temporary credentials come from /v1/oss/sts.
VITE_OSS_BUCKET=we-moment
VITE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# Empty uses the API base URL with /v1/oss/callback.
VITE_OSS_CALLBACK_URL=
